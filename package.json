{
  "name": "@nuxt/modules",
  "version": "0.6.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt/modules.git"
  },
  "homepage": "https://nuxt.com/modules",
  "main": "./modules.json",
  "files": [
    "modules.json"
  ],
  "scripts": {
    "build": "pnpm cli build",
    "cli": "node ./lib/cli.ts",
    "website:build": "pnpm build && nuxt build website",
    "website:dev": "pnpm build && nuxt dev website",
    "lint": "eslint",
    "release": "pnpm cli version && npm publish --tag latest",
    "sync": "pnpm cli sync",
    "test": "pnpm lint && pnpm sync"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@npm/types": "^2.1.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@octokit/rest": "^22.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.6",
    "defu": "^6.1.7",
    "dotenv": "^18.0.1",
    "eslint": "^10.11.0",
    "globby": "^16.2.4",
    "hasha": "^7.0.0",
    "js-yaml": "^5.4.2",
    "ofetch": "^1.5.1",
    "p-limit": "^7.3.3",
    "picocolors": "^1.1.1",
    "std-env": "^4.2.0",
    "typescript": "^6.0.3",
    "verkit": "^0.5.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
